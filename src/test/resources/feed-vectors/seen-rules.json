{
  "schema": "kurl.seen-rules",
  "version": 3,
  "decisions": [
    "2026-10-22 remote-latest-seen-later",
    "2026-10-23 home-latest-hide-seen",
    "2026-10-23 home-pull-reloads-unseen",
    "2026-10-23 home-ranked-for-you"
  ],
  "rules": [
    "a kurl note row is reported as kurl:note:{id}, a blog post row as kurl:post:{id}, a remote row by its uri; a remote row without a uri is not reported",
    "the server takes kurl:(note|post):{id} with id a decimal from 1 to 9223372036854775807 without leading zeros, lowercase only; anything else starting kurl: is dropped",
    "the server takes an http or https uri with a host up to 2048 characters; anything else is dropped",
    "on 홈 추천 a row counts as seen the moment any part of it is on screen while the app is in front, with no time floor",
    "on 둘러보기 다른 서버 a row counts once at least half of it has stayed on screen for 1 second while the app is in front",
    "팔로잉 does not report rows",
    "dwell is sent only for remote uris, as the running total once it reaches 1 second, capped at 10 minutes; kurl keys never carry dwell",
    "홈 추천 is one request, tab=for-you with seen=hide and the device header; 둘러보기 맞춤 carries the device header without seen=hide; 팔로잉 needs neither, since it neither records nor hides what was seen",
    "hide table (tab=latest, still served to 1.3.1): the server leaves a kurl note or post out when the same viewer has a record of it received before the scroll's asOf (stored or still buffered), unless a signed-in viewer wrote it; the ranked home's own rules are in home-rank",
    "hiding on tab=latest is on for a first page with seen=hide, or any h cursor (even malformed, even without seen=hide); an old <n>.<p> cursor never hides; tabs other than latest never hide",
    "a member and a device are different viewers; one never hides for the other",
    "iOS only: the cached first page of 홈 추천 is drawn without keys seen less than 14 days ago, my own included",
    "a pull sends the pending seen batch first and waits for it, then asks for the first page again",
    "a pull ends in exactly one notice: newRows, nothingNew, caughtUp or failed",
    "the request failing leaves the rows as they were and is failed",
    "otherwise the rows that came back are compared by key with the rows that were on screen: any new key is newRows (the rows are replaced quietly), none and nothing back is caughtUp, none with rows back is nothingNew"
  ],
  "format": {
    "keyFormat": "row → key a client reports",
    "accepted": "a string a client sends → as local (kind, itemId as a decimal string), remote, or dropped",
    "exposure": "surface, visibleRatio (0..1), visibleMs, appActive → counted",
    "dwell": "running total in ms for a key → sentMs, or null when nothing is sent",
    "requests": "which requests carry seen=hide, and whether the X-Kurl-Device header is required or not needed (sending it anyway does no harm)",
    "hide": "tab=latest only: viewer, request (tab, seenHide, cursor: none|h|h-malformed|old), item (ref kind:id, authorId), record (viewer, item, receivedBeforeAsOf, in: db|buffer) → shown",
    "cache": "iOS cached first page: seenSecondsAgo (null if never), authorIsMe → leftOut",
    "pull": "before: row keys on screen; result ok|failed; after: row keys of the first page that came back (absent when failed) → notice and rowsAfter"
  },
