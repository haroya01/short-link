# blocked here; a warned post never enters memory. Bringing one over reads it from memory, so only
# its author is fetched and kept (the reader was signed out when the page came, so nobody met the
# author ahead), then the note insert and the view.
@junit | federation-latest-first | 6 | 0 | 0 | 0 | 6
@junit | federation-latest-resolve | 12 | 2 | 0 | 0 | 14
# Suggestions: one statement over the accounts the member's follows follow, counted and ranked,
# leaving out accounts not open to suggestions, already followed or asked, blocked or muted, and
# servers suspended, limited or blocked by the member. Signing in comes first.
@junit | federation-account-suggestions | 1 | 0 | 0 | 0 | 1
@junit | federation-account-suggestions-anonymous | 0 | 0 | 0 | 0 | 0
# Note search with a public note from an account that opted into search: the one search statement,
# then the page as usual with its account from elsewhere (thread chain, remote author, media,
# stats).
@junit | notes-search-elsewhere | 5 | 0 | 0 | 0 | 5
# Resolving a handle already known and fresh reads as the lookup does: the account by handle (its
# server's block rides along), the member's follow of it, whether they blocked its server.
@junit | federation-resolve-handle | 3 | 0 | 0 | 0 | 3
# A profile address: is its server suspended, the instance key that signs the fetch; the document
# names another id, so that id is fetched the same way and only its answer is kept (lookup, insert)
# and read as the lookup does.
@junit | federation-resolve-profile | 7 | 1 | 0 | 0 | 8
# A note address: server suspended, instance key, is the note kept, its author (cached, fresh), then
# the inbox's INSERT IGNORE and its id; the answer is the account notes page's item for that note
# (note, its thread chain, remote author, media, stats, the member's marks). Asked again, the kept
# note is answered without a write; the account's notes page carries the same item, after the
# history fill finds its server silent (account, standing, outbox marked, notes counted, instance
# key).
@junit | federation-resolve-note | 11 | 1 | 0 | 0 | 12
@junit | federation-resolve-note-again | 9 | 0 | 0 | 0 | 9
@junit | federation-resolve-note-listed | 10 | 0 | 1 | 0 | 11
# A newly seen account's notes page: the account, the member's standing, its outbox marked looked
# at, its kept notes counted; then off the request thread the instance key and, from its outbox's
# first page, its own public top-level notes: each INSERT IGNORE and its id, a hashtag, the member
# a note names, a picture; nobody is told. Then the page (one name looked up for the mention).
# Asked again within six hours, only the account is read before the page.
@junit | federation-remote-notes-filled | 15 | 5 | 1 | 0 | 21
@junit | federation-remote-notes-filled-again | 8 | 0 | 0 | 0 | 8
# Failures: anonymous is turned away and this server's own addresses and malformed handles are
# answered before any query; a server that does not answer costs the block check and the instance
# key; a suspended server is never asked.
@junit | federation-resolve-anonymous | 0 | 0 | 0 | 0 | 0
@junit | federation-resolve-self | 0 | 0 | 0 | 0 | 0
@junit | federation-resolve-invalid | 0 | 0 | 0 | 0 | 0
@junit | federation-resolve-unreachable | 2 | 0 | 0 | 0 | 2
@junit | federation-resolve-suspended | 1 | 0 | 0 | 0 | 1
# Relays, which an admin subscribes the server to. Subscribing: the relay's actor (cached and fresh,
# so nothing is fetched), whether it is subscribed already, its row, then the Follow from the
# instance actor (dedupe check, insert).
@junit | admin-relay-subscribe | 3 | 2 | 0 | 0 | 5
# The relay accepts: its key, our follow by id and its state, then the accepted relays again (held
# in memory from then on).
@junit | federation-inbox-relay-accept | 3 | 0 | 1 | 0 | 4
# An accepted relay's announce is known from memory; only its key is read before the address is
# queued, and nothing about the post is looked at on the request.
@junit | federation-inbox-relay-announce | 1 | 0 | 0 | 0 | 1
# The admin view: the relays and how many kept notes each brought (one grouped count); the setting,
# the queue and the day's counts are in memory.
@junit | admin-relays | 2 | 0 | 0 | 0 | 2
@junit | admin-relays-member | 0 | 0 | 0 | 0 | 0
# The worker's step for one announced post: is it kept already, its server's block, the instance key
# that signs the fetch; its server does not resolve here, so it is counted as unanswered.
@junit | federation-relay-worker | 3 | 0 | 0 | 0 | 3
@junit | admin-relays-after-work | 2 | 0 | 0 | 0 | 2
# Changing the setting: its row and the update (with when it was chosen), then the view.
@junit | admin-relay-setting | 3 | 0 | 1 | 0 | 4
# Unsubscribing: the row, the Undo (dedupe check, insert), the delete, then the accepted relays
# again. An announce from it after that is not a relay's and costs nothing.
@junit | admin-relay-unsubscribe | 3 | 1 | 0 | 1 | 5
@junit | federation-inbox-relay-unsubscribed | 0 | 0 | 0 | 0 | 0
# STORE. The announce costs what it does in COUNT. The worker's step for a post its own server
# gives back: is it kept already, its server's block, the instance key that signs the fetch, then its
# author (cached and fresh here; an author seen first is fetched and inserted, three reads and one
# insert more); the note (insert, then its id), its picture's address, its tag, and the relay mark.
@junit | federation-inbox-relay-announce-store | 1 | 0 | 0 | 0 | 1
@junit | federation-relay-worker-store | 5 | 5 | 0 | 0 | 10
@junit | notes-federated-relayed | 6 | 0 | 0 | 0 | 6
