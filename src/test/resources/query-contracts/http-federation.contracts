# ActivityPub discovery, measured against Docker MySQL 2026-10-06.
# Never automatically update on test failure.
# identityType | identityValue | selectCount | insertCount | updateCount | deleteCount | totalCount
#
# First WebFinger creates the actor: active user, federation preference, actor lookup, the
# assigned-id merge check, insert.
@junit | federation-webfinger-first | 4 | 1 | 0 | 0 | 5
@junit | federation-webfinger-known | 3 | 0 | 0 | 0 | 3
@junit | federation-webfinger-before-delete | 4 | 1 | 0 | 0 | 5
# Actor documents and collections: actor by public id, the live user, their federation preference.
@junit | federation-actor | 3 | 0 | 0 | 0 | 3
@junit | federation-actor-html | 3 | 0 | 0 | 0 | 3
@junit | federation-actor-followers | 3 | 0 | 0 | 0 | 3
@junit | federation-actor-following | 3 | 0 | 0 | 0 | 3
# The outbox also counts the author's notes.
@junit | federation-actor-outbox | 4 | 0 | 0 | 0 | 4
# Featured lists the pinned note ids, newest pin first.
@junit | federation-actor-featured | 4 | 0 | 0 | 0 | 4
@junit | federation-host-meta | 0 | 0 | 0 | 0 | 0
@junit | federation-nodeinfo-discovery | 0 | 0 | 0 | 0 | 0
@junit | federation-nodeinfo | 0 | 0 | 0 | 0 | 0
# A soft-deleted account stops resolving. After commit it leaves: actor, the accounts it follows
# elsewhere (none here), follower inboxes (none here), then the follower rows are cleared.
@junit | federation-account-delete | 5 | 1 | 1 | 1 | 8
@junit | federation-webfinger-after-delete | 1 | 0 | 0 | 0 | 1
@junit | federation-actor-after-delete | 2 | 0 | 0 | 0 | 2
# The instance actor (signs fetches): first request creates its key, later ones only read it.
@junit | federation-instance-first | 2 | 1 | 0 | 0 | 3
@junit | federation-instance-known | 1 | 0 | 0 | 0 | 1
# Mastodon resolves the instance actor's acct back to its id before trusting its key; answered from config.
@junit | federation-webfinger-instance | 0 | 0 | 0 | 0 | 0
# Inbox POSTs signed by a seeded remote actor whose key is cached, so nothing is fetched remotely.
# Follow to the personal inbox: inbox owner (actor, user), key, follower lookup and insert, Accept
# dedupe check and insert. A new follower notifies the user (preference, insert, recipient name,
# remote actor); a refollow does not.
@junit | federation-inbox-follow | 9 | 3 | 0 | 0 | 12
@junit | federation-inbox-follow-before-leave | 9 | 3 | 0 | 0 | 12
# The shared inbox resolves the target (actor, user, preference); the existing row takes the new
# follow id.
@junit | federation-inbox-refollow | 6 | 1 | 1 | 0 | 8
# The target is resolved before the signature is checked; an unsigned request writes nothing.
@junit | federation-inbox-unsigned | 3 | 0 | 0 | 0 | 3
@junit | federation-inbox-undo | 2 | 0 | 0 | 1 | 3
@junit | federation-inbox-ignored | 0 | 0 | 0 | 0 | 0
# Key, then the actor row by id and its delete; followers go with it by ON DELETE CASCADE.
@junit | federation-inbox-delete-actor | 2 | 0 | 0 | 1 | 3
@junit | federation-inbox-delete-unknown-actor | 1 | 0 | 0 | 0 | 1
@junit | federation-inbox-unknown | 1 | 0 | 0 | 0 | 1
# Likes and boosts from a remote account. The target is checked before the signature with the rule
# that serves the note document (note, author, images, then the author's user, preference, actor);
# a personal inbox reuses its owner when the owner wrote the note. Then the key and INSERT IGNORE.
# A new reaction re-reads the note for its author and notifies them (whether they muted this
# conversation, preference, group check, insert, recipient name, remote actor); a re-sent one only
# refreshes its activity id; a Like again after an Undo on the same day finds the actor already in
# the group and writes no notification.
@junit | federation-inbox-like | 13 | 2 | 0 | 0 | 15
@junit | federation-inbox-like-again | 7 | 1 | 1 | 0 | 9
@junit | federation-inbox-announce | 13 | 2 | 0 | 0 | 15
@junit | federation-inbox-like-before-delete | 11 | 1 | 0 | 0 | 12
# A member likes the same note: the like and the author's notice joining today's group.
@junit | federation-note-member-like | 8 | 2 | 0 | 0 | 10
# The author's inbox reads groups, not rows: each group's newest row with its size and unread sum
# in one query, the newest three actors of groups larger than one (window function), then members
# and remote accounts by id. Unread counts groups; reading a group's newest row reads the group.
@junit | notification-note-groups | 4 | 0 | 0 | 0 | 4
@junit | notification-note-unread | 1 | 0 | 0 | 0 | 1
@junit | notification-note-group-read | 0 | 0 | 1 | 0 | 1
# Counts are public: the author and anyone else read the same one count statement for the page.
@junit | federation-note-remote-counts | 6 | 0 | 0 | 0 | 6
@junit | federation-note-remote-counts-stranger | 6 | 0 | 0 | 0 | 6
# Undo of an embedded Like deletes by note, actor and kind; a bare activity id clears a follow or a
# reaction with that id.
@junit | federation-inbox-undo-like | 1 | 0 | 0 | 1 | 2
@junit | federation-inbox-undo-by-id | 1 | 0 | 0 | 2 | 3
# Reactions go with the actor row by ON DELETE CASCADE.
@junit | federation-inbox-delete-liker | 2 | 0 | 0 | 1 | 3
# Notes and settings, with one seeded remote follower. Note steps include the after-commit delivery
# work: actor, follower inboxes, preference, then the note (note, author, images) and the queue.
@junit | federation-settings-get | 2 | 0 | 0 | 0 | 2
@junit | federation-settings-notice | 2 | 1 | 0 | 0 | 3
@junit | federation-note-create | 9 | 3 | 0 | 0 | 12
@junit | federation-note-edit | 13 | 2 | 1 | 1 | 17
@junit | federation-note-delete | 6 | 1 | 0 | 3 | 10
# The note document: note, author, images, then the author's actor (user, preference, actor).
@junit | federation-note-document | 6 | 0 | 0 | 0 | 6
@junit | federation-note-page | 6 | 0 | 0 | 0 | 6
# Reposting your own note: the repost write and its public count (one statement), then the
# Announce, which reads the note to find its author's actor. Undo reads nothing but the reposter's
# actor. A quote reads the quoted note and its author on both the write and the delivery side.
@junit | federation-note-repost | 14 | 2 | 0 | 0 | 16
@junit | federation-note-unrepost | 7 | 1 | 0 | 1 | 9
@junit | federation-note-quote | 15 | 2 | 0 | 0 | 17
# Turning federation off unfollows accounts elsewhere (none here), sends Delete(Person) to follower
# servers and clears the followers.
@junit | federation-settings-off | 6 | 1 | 1 | 1 | 9
@junit | federation-webfinger-opted-out | 2 | 0 | 0 | 0 | 2
@junit | federation-settings-on | 2 | 0 | 1 | 0 | 3
@junit | federation-account-delete-leaves | 6 | 2 | 1 | 1 | 10
# A vote from another server is a Create of a Note named after the option, replying to the Question.
# The target check is the like's (the note snapshot, which reads the poll's tally too, and the
# author's actor), then the key, the note and one INSERT IGNORE: a single-choice poll keeps the first
# vote. The Question document adds the tally to the note document's reads.
@junit | federation-inbox-vote | 9 | 1 | 0 | 0 | 10
@junit | federation-inbox-vote-again | 9 | 1 | 0 | 0 | 10
@junit | federation-note-question | 7 | 0 | 0 | 0 | 7
# A member follows an account on another server. The account is cached and fresh, so the lookup
# asks no one remotely: the account by handle, then the member's follow of it.
@junit | federation-remote-lookup | 2 | 0 | 0 | 0 | 2
# Follow: the account, the member's actor (user, preference, actor), no follow yet, the follow row,
# then the Follow delivery's dedupe check and insert.
@junit | federation-remote-follow | 6 | 2 | 0 | 0 | 8
# Accept to the personal inbox: inbox owner (actor, user, preference), the signer's key, our follow
# by its id, and its accepted time.
@junit | federation-remote-accept | 5 | 0 | 1 | 0 | 6
@junit | federation-remote-following | 2 | 0 | 0 | 0 | 2
@junit | federation-remote-account | 2 | 0 | 0 | 0 | 2
# Unfollow: the account, the follow, the member's actor for the Undo, its delivery, the row.
@junit | federation-remote-unfollow | 4 | 1 | 0 | 1 | 6
# Notes from an account a member follows. Before the key: is anyone following it. Then the key,
# INSERT IGNORE on the note's uri, its id, and its image (the address stays on its server).
@junit | federation-inbox-remote-note | 3 | 2 | 0 | 0 | 5
# The following feed carries it: a page of only remote notes reads their accounts, never users.
@junit | notes-following-remote | 6 | 0 | 0 | 0 | 6
@junit | federation-remote-notes | 5 | 0 | 0 | 0 | 5
# All notes stays kurl's own (remote_actor_id IS NULL), the same four queries as before.
@junit | notes-everyone-without-remote | 4 | 0 | 0 | 0 | 4
# A reply to a member's note is wanted from anyone: the target is checked with the note document's
# rule (note, author, images, user, preference, actor), then the key, the parent, the insert and its
# id; the author hears of it (muted conversation, preference, notification, recipient, remote
# actor).
@junit | federation-inbox-remote-reply | 13 | 2 | 0 | 0 | 15
@junit | notes-thread-remote-reply | 6 | 0 | 0 | 0 | 6
# Edits and deletes first ask whether we kept that note, so others never cost a key fetch.
@junit | federation-inbox-remote-update | 2 | 0 | 1 | 0 | 3
@junit | federation-inbox-remote-delete | 2 | 0 | 0 | 1 | 3
# A note no member follows, answers or is named in: one question, then nothing.
@junit | federation-inbox-remote-unsolicited | 1 | 0 | 0 | 0 | 1
# A member likes, boosts and answers a note from elsewhere; each reaches its author's server. After
# the member's own work: their actor (user, preference, actor), the note and its account, then the
# delivery (dedupe check, insert). A boost and a reply also go to the member's followers' servers.
@junit | federation-remote-note-like | 9 | 2 | 0 | 0 | 11
@junit | federation-remote-note-repost | 11 | 2 | 0 | 0 | 13
@junit | federation-remote-note-reply | 13 | 2 | 0 | 0 | 15
