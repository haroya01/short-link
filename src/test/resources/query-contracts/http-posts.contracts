# Exact JDBC execution counts for real HTTP requests; fixtures and DB assertions are outside capture.
# Review changes with the actual SQL evidence in build/reports/query-audit/http-contracts/.
# identityType | identityValue | selectCount | insertCount | updateCount | deleteCount | totalCount
# Feed: posts page + total count + authors batch + tags batch, at every tested page size.
@junit | feed-recent-size-1 | 4 | 0 | 0 | 0 | 4
@junit | feed-recent-size-8 | 4 | 0 | 0 | 0 | 4
@junit | feed-recent-size-20 | 4 | 0 | 0 | 0 | 4
# Create: author lookup + slug availability + committed post insert.
@junit | post-create | 2 | 1 | 0 | 0 | 3
# Read: ownership lookup + ordered blocks.
@junit | post-blocks-read | 2 | 0 | 0 | 0 | 2
# Replace: ownership + ordered blocks + tags; one blocks insert + search-text upsert;
# post edit timestamp update + old blocks delete. Six body rows still use one block INSERT.
@junit | post-blocks-replace-six | 3 | 2 | 1 | 1 | 7
# A note carried as a card (its URL on a line of its own). A draft keeps no record of it, so an
# autosave is the same seven statements as any replace.
@junit | post-blocks-replace-draft-quote | 3 | 2 | 1 | 1 | 7
# Saving from the current content version is the same replace: the version rides in the post update
# it already makes.
@junit | post-edit-blocks-current-version | 3 | 2 | 1 | 1 | 7
# Saving from an older version stops at the locked post read; nothing is written.
@junit | post-edit-blocks-stale-version | 1 | 0 | 0 | 0 | 1
@junit | post-edit-metadata-stale-version | 1 | 0 | 0 | 0 | 1
# Metadata from the current version: locked post + body + tags for the search text; its upsert; the
# post update.
@junit | post-edit-metadata-current-version | 3 | 1 | 1 | 0 | 5
# Overwrite first keeps the replaced post as a revision (its blocks, the latest revision number, one
# insert), then replaces the body as usual.
@junit | post-edit-markdown-overwrite | 5 | 3 | 1 | 1 | 10
# Publishing for the first time: the usual first publish plus one insert of the notes it carries;
# nothing was kept before, so nothing is cleared.
@junit | post-publish-quoting-note | 14 | 4 | 1 | 0 | 19
# Editing a public post's body also clears and rewrites the notes it carries (delete + insert).
@junit | post-blocks-replace-published-quote | 10 | 3 | 1 | 2 | 16
# Posts carrying a note: the page of published posts, their authors and tags in one batch each; an
# empty page stops after the first statement.
@junit | note-quoting-posts | 3 | 0 | 0 | 0 | 3
@junit | note-quoting-posts-after-edit | 1 | 0 | 0 | 0 | 1
# The note's thread counts the post among its quotes inside the same stats statement.
@junit | note-thread-quoted-in-post | 8 | 0 | 0 | 0 | 8
