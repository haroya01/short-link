# Notes, measured against Docker MySQL 2026-10-06. Never automatically update on test failure.
# identityType | identityValue | selectCount | insertCount | updateCount | deleteCount | totalCount
#
# Presign signs a storage URL only; nothing touches the database. Writes include the after-commit
# federation check, which stops at the actor lookup for an author nobody follows remotely.
@junit | note-image-presign | 0 | 0 | 0 | 0 | 0
# Create: moderation check (user), quoted post, note and image inserts, then the author for the
# response. Reply/like counts of a new note are known to be zero and are not queried. After commit,
# a new top-level note that is not direct asks once for the followers who rang the author's bell.
@junit | note-create | 5 | 2 | 0 | 0 | 7
# Replies, likes, reposts and quotes also notify the note's author after commit: whether the author
# blocked the actor, their preference for the type, for likes and reposts whether this actor is
# already in today's group, the insert, then the recipient's and the actor's names for the push.
# Reply: moderation, parent note, a block check each way, insert, author.
@junit | note-reply | 11 | 2 | 0 | 0 | 13
# A thread posts its notes in one transaction, each as a reply to the one before: per note the same
# work as a single create (authors, insert, and after commit the federation and bell checks), the
# first note's moderation check once, and for every later note the block check each way.
@junit | note-thread-create | 14 | 3 | 0 | 0 | 17
# Reading that thread: its first note lists the later parts in order apart from other replies, and
# the public feed carries the second part under the first.
@junit | note-thread-parts | 8 | 0 | 0 | 0 | 8
@junit | note-everyone-thread | 7 | 0 | 0 | 0 | 7
# Liking or reposting answers with the note's public counts in one statement, whoever asks.
@junit | note-like | 8 | 2 | 0 | 0 | 10
# Repost: note, moderation, a block check each way, the existing row, insert, then the after-commit
# federation check. Undoing it reads the row it deletes so the Undo can name the Announce.
@junit | note-repost | 12 | 2 | 0 | 0 | 14
@junit | note-unrepost | 4 | 0 | 0 | 1 | 5
# Quote: moderation, quoted note, a block check each way, both authors in one read, insert, the
# quoted note's images.
@junit | note-quote | 13 | 2 | 0 | 0 | 15
# A page of notes costs one query per kind of data: notes, quoted notes (only when one quotes),
# authors, images, quoted posts, one statement for the page's reply, like, repost and quote counts
# (public, likes and boosts from other servers included) and, for a signed-in reader, one statement
# for what they liked, reposted and bookmarked. Feeds and a note's thread also walk the author's own
# replies under the top-level notes in one recursive statement (a thread written in parts) and, when
# there are parts, read the next ones in one more query and view them with the page.
@junit | note-reposts | 8 | 0 | 0 | 0 | 8
# A shared note's thread also reads the series it belongs to, with that series' readable items, in
# one statement.
@junit | note-thread | 9 | 0 | 0 | 0 | 9
# Quotes of a note: the notes quoting it, then the page as usual (anonymous, so no reader marks).
@junit | note-quotes | 6 | 0 | 0 | 0 | 6
@junit | post-note-quotes | 7 | 0 | 0 | 0 | 7
# Bookmarks are the reader's own: the note, the existing row, insert or delete. The list reads the
# reader's bookmark ids newest first, those notes, then the page as usual.
@junit | note-bookmark | 2 | 1 | 0 | 0 | 3
@junit | note-bookmarks | 8 | 0 | 0 | 0 | 8
@junit | note-unbookmark | 2 | 0 | 0 | 1 | 3
@junit | note-profile | 8 | 0 | 0 | 0 | 8
@junit | note-following | 9 | 0 | 0 | 0 | 9
# The following feed takes reposts too: follows, then one query that unions the authors' top-level
# notes with their reposts, keeps each note once at its newest activity (ROW_NUMBER), leaves out
# reposts of people the reader blocked either way or hid, and returns the note rows; then the reposters'
# names, and the page is built like any other.
@junit | note-following-reposts | 8 | 0 | 0 | 0 | 8
# Hiding reposts changes only what the reader sees. Per person: the username, then the row (insert
# ignore, select or delete). The feed filters both settings inside the same union query, so hiding
# costs it nothing; with every repost off there are no reposter names to read.
@junit | note-hide-reposts | 1 | 1 | 0 | 0 | 2
@junit | note-repost-visibility | 2 | 0 | 0 | 0 | 2
@junit | note-show-reposts | 1 | 0 | 0 | 1 | 2
@junit | note-following-hidden-reposts | 8 | 0 | 0 | 0 | 8
@junit | note-feed-preferences | 1 | 0 | 0 | 0 | 1
@junit | note-feed-preferences-update | 1 | 1 | 0 | 0 | 2
@junit | note-following-no-reposts | 7 | 0 | 0 | 0 | 7
@junit | note-everyone | 7 | 0 | 0 | 0 | 7
# Hashtags: a note's tags go in with one multi-row insert after the note (none when it has no tags).
# An edit rewrites them (delete, insert) only when the set of tags changed. The tag page reads the
# tagged notes newest first, then builds the page as usual. Notes under a tag the reader follows join
# the following feed inside its one union query.
@junit | note-create-tagged | 4 | 2 | 0 | 0 | 6
@junit | note-tagged | 5 | 0 | 0 | 0 | 5
@junit | note-following-tags | 7 | 0 | 0 | 0 | 7
@junit | note-edit-retag | 9 | 2 | 1 | 1 | 13
# Mentions: the mentioned handles ride in the authors query (id IN … OR username IN …), so neither
# writing nor reading a note with mentions adds a query. Each mentioned member is told after commit
# like any other note notice: block check, preference, insert, then both names for the push.
@junit | note-create-mention | 9 | 2 | 0 | 0 | 11
@junit | note-thread-mention | 7 | 0 | 0 | 0 | 7
# A content warning and the sensitive mark are columns on the note: they ride in its one insert and
# its one update (the edit also keeps the version it replaces).
@junit | note-create-warning | 4 | 1 | 0 | 0 | 5
@junit | note-edit-warning | 9 | 1 | 1 | 0 | 11
# Edits keep the version they replace (Mastodon edit history): one insert per edit that changes
# anything; an edit that changes nothing is not an edit. History reads the note, checks the author is
# still active, then the earlier versions newest first.
@junit | note-history | 3 | 0 | 0 | 0 | 3
# Pins: the note, how many the author already pinned (at most five), the update. The profile list
# orders pins first inside its one query, so a pinned profile costs the same.
@junit | note-pin | 2 | 0 | 1 | 0 | 3
@junit | note-unpin | 1 | 0 | 1 | 0 | 2
@junit | note-profile-pinned | 6 | 0 | 0 | 0 | 6
# Trending ranks the week's top-level notes in one query (reaction counts are correlated
# subqueries inside it), then builds the page like the public feed.
@junit | note-trending | 7 | 0 | 0 | 0 | 7
# Trending hashtags (Mastodon's): one statement — a week of public notes grouped by tag, the
# accounts and the notes per day counted in it, blocked servers left out.
@junit | note-trending-tags | 1 | 0 | 0 | 0 | 1
# Trending links rank link cards the same way, in one statement. A link's notes read like a tag's
# (notes, authors, media, stats) plus the batch of their link cards, which these notes carry.
@junit | note-trending-links | 1 | 0 | 0 | 0 | 1
@junit | note-linked-notes | 6 | 0 | 0 | 0 | 6
# After commit an edit asks once who reposted or quoted the note (Mastodon's update notice). Here
# the reader's quote is still up, so they hear of it: preference, insert, names for the push.
@junit | note-edit | 14 | 2 | 1 | 0 | 17
@junit | note-edit-denied | 2 | 0 | 0 | 0 | 2
# Delete: note, its image keys, then likes, collection blocks, its place in a series and the note
# (images cascade).
@junit | note-delete | 3 | 0 | 0 | 4 | 7
@junit | note-thread-gone | 1 | 0 | 0 | 0 | 1
# A reply whose parent was deleted stays a reply: the replier's profile and trending leave it out
# inside their one query, at the same cost as before.
@junit | note-profile-orphan | 6 | 0 | 0 | 0 | 6
@junit | note-trending-orphan | 5 | 0 | 0 | 0 | 5
# A note with an address: the card is fetched after commit off the request thread and stored with
# one upsert. Reading it back adds one card query, and only for pages that have an address at all.
@junit | note-create-link | 4 | 2 | 0 | 0 | 6
@junit | note-thread-link | 8 | 0 | 0 | 0 | 8
# Visibility (Mastodon's four). Restricted notes (followers-only, direct) record the members they
# mention as recipients in one insert; they still get their mention notices. Shared feeds (everyone,
# tags) filter public inside their one query. A page with restricted notes by someone else asks once
# which of them this viewer may read (author, recipient, or follower for followers-only); a page of
# public notes asks nothing more. Hidden notes answer 404 on every path. /ap/notes serves only public
# and unlisted notes (its first read also creates the author's actor).
@junit | note-vis-create-public | 4 | 2 | 0 | 0 | 6
@junit | note-vis-create-unlisted | 4 | 2 | 0 | 0 | 6
@junit | note-vis-create-private | 9 | 4 | 0 | 0 | 13
# A direct mention from someone the recipient doesn't follow is an unsolicited private mention,
# which the default notification policy keeps aside: stored filtered, no push (its two lookups go).
@junit | note-vis-create-direct | 6 | 4 | 0 | 0 | 10
@junit | note-vis-everyone | 7 | 0 | 0 | 0 | 7
@junit | note-vis-tagged | 5 | 0 | 0 | 0 | 5
@junit | note-vis-profile-anonymous | 6 | 0 | 0 | 0 | 6
@junit | note-vis-profile-follower | 8 | 0 | 0 | 0 | 8
@junit | note-vis-profile-mentioned | 8 | 0 | 0 | 0 | 8
@junit | note-vis-profile-author | 7 | 0 | 0 | 0 | 7
@junit | note-vis-thread-private-stranger | 5 | 0 | 0 | 0 | 5
@junit | note-vis-thread-private-follower | 8 | 0 | 0 | 0 | 8
@junit | note-vis-thread-direct-follower | 5 | 0 | 0 | 0 | 5
@junit | note-vis-thread-direct-mentioned | 8 | 0 | 0 | 0 | 8
@junit | note-vis-history-private-anonymous | 2 | 0 | 0 | 0 | 2
@junit | note-vis-direct-mentioned | 7 | 0 | 0 | 0 | 7
@junit | note-vis-direct-follower | 1 | 0 | 0 | 0 | 1
@junit | note-vis-following-follower | 8 | 0 | 0 | 0 | 8
@junit | note-vis-following-mentioned | 8 | 0 | 0 | 0 | 8
@junit | note-vis-like-private-stranger | 2 | 0 | 0 | 0 | 2
@junit | note-vis-repost-private-follower | 2 | 0 | 0 | 0 | 2
@junit | note-vis-reply-direct-follower | 3 | 0 | 0 | 0 | 3
@junit | note-vis-ap-private | 3 | 0 | 0 | 0 | 3
@junit | note-vis-ap-unlisted | 7 | 1 | 0 | 0 | 8
# Lists are their owner's alone. Every call first finds the list by id and owner (a stranger gets
# 404 there). Mine counts members in one grouped query; adding checks the person and the member cap
# before an insert ignore; the feed is one query over the members' notes under the profile's
# visibility rules, then the usual page. Deleting a list removes its members by cascade.
@junit | note-list-create | 1 | 1 | 0 | 0 | 2
@junit | note-list-add | 3 | 1 | 0 | 0 | 4
@junit | note-list-mine | 1 | 0 | 0 | 0 | 1
@junit | note-list-members | 3 | 0 | 0 | 0 | 3
@junit | note-list-membership | 2 | 0 | 0 | 0 | 2
@junit | note-list-feed | 7 | 0 | 0 | 0 | 7
@junit | note-list-feed-stranger | 1 | 0 | 0 | 0 | 1
@junit | note-list-rename | 2 | 0 | 1 | 0 | 3
@junit | note-list-remove | 2 | 0 | 0 | 1 | 3
@junit | note-list-delete | 1 | 0 | 0 | 1 | 2
# Polls (Mastodon's): options, end and choice mode ride on the note row, so writing one adds no
# statement and a page reads one tally (local and remote votes in one union) only when it holds a
# poll. A vote reads the note, a block check each way, then one INSERT IGNORE on (note, voter): a
# second vote inserts nothing and answers 409; the response is the fresh tally. The author and an
# ended poll are refused after the note read.
@junit | note-create-poll | 4 | 1 | 0 | 0 | 5
@junit | note-poll-vote | 4 | 1 | 0 | 0 | 5
@junit | note-poll-vote-again | 3 | 1 | 0 | 0 | 4
@junit | note-poll-vote-own | 1 | 0 | 0 | 0 | 1
@junit | note-poll-vote-ended | 1 | 0 | 0 | 0 | 1
@junit | note-thread-poll | 8 | 0 | 0 | 0 | 8
# Mutes (Mastodon's, account-level like blocks). Muting reads the person and the existing row, then
# inserts or updates; unmuting deletes it. Shared lists (all notes, trending, tags, the following
# feed, lists, a thread's replies, quotes) keep out authors blocked either way or muted, inside
# their one query, so they cost what they did. A muted person's reply stops at the notice check,
# which asks block-or-muted-notices in the one statement the block check was.
@junit | user-mute | 2 | 1 | 0 | 0 | 3
@junit | user-mute-status | 2 | 0 | 0 | 0 | 2
@junit | user-mutes | 2 | 0 | 0 | 0 | 2
@junit | note-everyone-muted | 8 | 0 | 0 | 0 | 8
@junit | note-reply-muted | 7 | 1 | 0 | 0 | 8
@junit | note-thread-muted | 8 | 0 | 0 | 0 | 8
@junit | user-unmute | 2 | 0 | 0 | 1 | 3
# Keyword filters (Mastodon's) are stored for the owner's apps, which apply them, so no feed reads
# them. Create counts the owner's filters (at most a hundred) then inserts; every other call first
# finds the filter by id and owner, which is where a stranger gets 404.
@junit | note-filter-create | 1 | 1 | 0 | 0 | 2
@junit | note-filters | 1 | 0 | 0 | 0 | 1
@junit | note-filter-update | 1 | 0 | 1 | 0 | 2
@junit | note-filter-update-stranger | 1 | 0 | 0 | 0 | 1
@junit | note-filter-delete | 1 | 0 | 0 | 1 | 2
# Note search reads public notes newest first in one query (the body's ngram FULLTEXT index, or LIKE
# for a query the index cannot hold) under the same block and mute rules as every shared list, then
# builds the page as usual.
@junit | note-search-seed-private | 4 | 1 | 0 | 0 | 5
@junit | note-search | 5 | 0 | 0 | 0 | 5
@junit | note-search-short | 5 | 0 | 0 | 0 | 5
# Mastodon's mute conversation. A reply joins its thread's root (no extra write: a top-level note is
# its own conversation). Muting reads the note for its conversation and INSERT IGNOREs the mute;
# the reader's marks pick it up in the same statement as likes, reposts and bookmarks.
@junit | note-reply-before-mute | 11 | 2 | 0 | 0 | 13
@junit | note-conversation-mute | 1 | 1 | 0 | 0 | 2
@junit | note-thread-conversation-muted | 8 | 0 | 0 | 0 | 8
# A reply or a like in the muted thread stops at the one silence check (block, mute, conversation).
@junit | note-reply-conversation-muted | 7 | 1 | 0 | 0 | 8
@junit | note-like-conversation-muted | 4 | 1 | 0 | 0 | 5
@junit | note-conversation-unmute | 1 | 0 | 0 | 1 | 2
# Mastodon's bell on a followed account. Only a follower rings it (409 before following): the
# target, then the follow row, updated in place. The follow status reads the bell from that row,
# and the blocks between the two both ways in one statement.
@junit | note-bell-before-follow | 2 | 0 | 0 | 0 | 2
@junit | note-bell-on | 2 | 0 | 1 | 0 | 3
@junit | note-bell-follow-status | 5 | 0 | 0 | 0 | 5
# A new note finds the bell-ringers in one query (blocks and notice mutes excluded), then records
# their notices like other fan-outs: preferences in one read, the insert, names for the push.
@junit | note-create-bell | 8 | 2 | 0 | 0 | 10
# A reply to someone else's note rings no bell; Mastodon tells of posts and self-threads only.
@junit | note-reply-bell-elsewhere | 11 | 2 | 0 | 0 | 13
@junit | note-bell-off | 2 | 0 | 1 | 0 | 3
# Who shared a note hears of its edit, once each: a reposter and a quoter, never the author who
# reposted their own note, nor anyone who blocked or muted them or the conversation (one query).
@junit | note-repost-before-edit | 12 | 2 | 0 | 0 | 14
@junit | note-quote-before-edit | 13 | 2 | 0 | 0 | 15
@junit | note-repost-own-before-edit | 7 | 1 | 0 | 0 | 8
@junit | note-edit-shared | 13 | 3 | 1 | 0 | 17
# Mastodon's scheduled statuses. Scheduling asks the writer's load (waiting, and on that UTC day)
# in one query, checks the draft as a post would (moderation, mentioned members), then stores it.
# Too soon stops before any query. The job posts a due note and drops its row in one transaction.
@junit | note-schedule-too-soon | 0 | 0 | 0 | 0 | 0
@junit | note-schedule | 3 | 1 | 0 | 0 | 4
@junit | note-schedule-another | 3 | 1 | 0 | 0 | 4
@junit | note-schedules | 1 | 0 | 0 | 0 | 1
@junit | note-schedule-move | 1 | 0 | 1 | 0 | 2
@junit | note-schedule-cancel | 1 | 0 | 0 | 1 | 2
# Mastodon's posting language and filter languages. A note keeps its language in its one insert.
# Choosing languages is one upsert, then the answer reads both settings back (either may change
# alone). All notes asks the choice inside its one query, so the page costs what it did.
@junit | note-create-language | 4 | 1 | 0 | 0 | 5
@junit | note-feed-languages | 1 | 1 | 0 | 0 | 2
@junit | note-everyone-languages | 6 | 0 | 0 | 0 | 6
