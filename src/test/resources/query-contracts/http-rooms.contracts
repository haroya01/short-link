# Rooms, measured against Docker MySQL 2026-10-20 (CI run 39339848908). Never automatically update
# on test failure.
# identityType | identityValue | selectCount | insertCount | updateCount | deleteCount | totalCount
#
# Making a room: the room, its owner as the first member (watermark from the room's newest note),
# then the room as the owner sees it: membership, members, their feed setting.
@junit | room-create | 3 | 2 | 0 | 0 | 5
# An invite: membership, the invite row, then the kurl short link to the invite page through the
# usual link creation (blocked domains, quota, link and its policy rows, audit, OG metadata of the
# page), the invite updated with its short code, and the creator for the answer.
@junit | room-invite-create | 7 | 7 | 3 | 0 | 17
# The public invite page: invite, room, member count, inviter and up to eight faces. No note is read.
@junit | room-invite-landing | 5 | 0 | 0 | 0 | 5
# Joining locks the invite and then the room; membership, removal and an open request are checked,
# the seats counted, the use recorded and the member added.
@junit | room-join | 6 | 1 | 1 | 0 | 8
# Through an approval invite or room the same checks end in a request instead of a membership.
@junit | room-join-request | 6 | 1 | 1 | 0 | 8
@junit | room-join-request-again | 6 | 1 | 1 | 0 | 8
# A room note: moderation (user), authors, membership, insert, the room's name for the answer, and
# after commit the federation actor lookup, which stops there since a room note never leaves.
@junit | room-note-create | 5 | 1 | 0 | 0 | 6
# A reply inside the room: the parent and whether the replier may read it (one readable lookup), a
# block check each way, authors, membership, insert; who of those answered may read the reply (one
# readersAmong statement), the room's name, the federation actor; after commit the parent's author
# hears of it as for any reply.
@junit | room-note-reply | 15 | 2 | 0 | 0 | 17
# The room's notes as a member reads them: membership, the page, thread parts, authors, one
# readable lookup for the room notes, media, counts, marks and the room's name.
@junit | room-notes | 9 | 0 | 0 | 0 | 9
# Every room the member is in, newest first: the room notes page as above without the membership
# check, which the join to room_member is.
@junit | room-feed | 8 | 0 | 0 | 0 | 8
# The following feed carrying a room note: the same statements as any following page plus the one
# readable lookup and the room's name, only because the page has a room note.
@junit | room-following | 9 | 0 | 0 | 0 | 9
# A blog post written into a room: moderation (user), the slug, membership of the room, the insert,
# and the room's name for the answer.
@junit | room-post-create | 4 | 1 | 0 | 0 | 5
# Publishing it: the post locked, moderation, whether the author is still in the room, the
# revision and search text as for any publish, the room's name. No follower or note author is told.
@junit | room-post-publish | 8 | 2 | 1 | 0 | 11
# A member reads it: author, the post, membership, tags, the room's name, blocks.
@junit | room-post-read | 6 | 0 | 0 | 0 | 6
# The room's notes and blog posts as one list, measured in CI run 39559848410: the room notes page
# exactly as room-notes (membership, the page, thread parts, authors, one readable lookup, media,
# counts, marks, the room's name), then the room posts page, their authors, the room's name again
# (the post slice names its own rooms), tags and comment counts with the reader's likes, then the
# latest replies: one statement for every note's replies and one for every post's comments, so a
# longer page costs no more statements.
@junit | room-items | 16 | 0 | 0 | 0 | 16
# Across every room of the member: the same without the membership check, which the notes page
# joins to room_member and the posts page asks in its own condition.
@junit | room-items-all | 15 | 0 | 0 | 0 | 15
# Someone outside the room stops at membership with the not-found of a post that does not exist.
@junit | room-post-outsider | 3 | 0 | 0 | 0 | 3
# Every room of the member, its newest note, unread count and members in one statement, then up
# to three faces per room besides the member in one more.
@junit | room-list | 2 | 0 | 0 | 0 | 2
@junit | room-read | 2 | 0 | 1 | 0 | 3
@junit | room-detail | 4 | 0 | 0 | 0 | 4
# Pinning: membership, whether it is pinned already, the member's pin count against five, the
# update. Unpinning skips the count.
@junit | room-pin | 3 | 0 | 1 | 0 | 4
@junit | room-unpin | 2 | 0 | 1 | 0 | 3
@junit | room-feed-hide | 1 | 0 | 1 | 0 | 2
@junit | room-feed-show | 1 | 0 | 1 | 0 | 2
# The owner's changes run under the room's row lock, then the room is read back as on detail.
@junit | room-update | 5 | 0 | 1 | 0 | 6
@junit | room-requests | 3 | 0 | 0 | 0 | 3
@junit | room-request-approve | 3 | 1 | 0 | 1 | 5
@junit | room-request-reject | 2 | 0 | 0 | 1 | 3
@junit | room-invites | 4 | 0 | 0 | 0 | 4
@junit | room-invite-disable | 4 | 0 | 1 | 0 | 5
# Removing a member: lock, both memberships, the membership deleted, their invites stopped and the
# removal kept so no invite lets them back in.
@junit | room-member-remove | 3 | 1 | 1 | 1 | 6
@junit | room-my-notes | 6 | 0 | 0 | 0 | 6
# Leaving and keeping the notes: lock, membership, the membership deleted, the member's invites
# stopped.
@junit | room-leave | 2 | 0 | 1 | 1 | 4
# Deleting one's notes in a room only records the request; RoomNoteErasureJob deletes them later
# in chunks, so the request stays one statement however many notes there are.
@junit | room-my-notes-delete | 0 | 1 | 0 | 0 | 1
# Deleting one's room posts and what one said on room posts only records the request, as for notes;
# RoomPostErasureJob deletes them later in chunks.
@junit | room-my-posts-delete | 0 | 1 | 0 | 0 | 1
@junit | room-suggestions | 1 | 0 | 0 | 0 | 1
@junit | room-suggestions-dismiss | 0 | 1 | 0 | 0 | 1
# Inviting by name: the room locked, membership, the waiting count against the cap, one insert for
# everyone asked (whoever cannot be asked is left out inside it), then who waits now.
@junit | room-invitation-send | 4 | 1 | 0 | 0 | 5
@junit | room-invitees | 3 | 0 | 0 | 0 | 3
# The invitee's own invitations, with room, inviter and member count, in one statement.
@junit | room-invitations-mine | 1 | 0 | 0 | 0 | 1
# Accepting is joining: lock, the invitation taken, then the same membership, removal, request
# and seat checks as an invite link before the member is added.
@junit | room-invitation-accept | 6 | 1 | 0 | 1 | 8
@junit | room-invitation-decline | 0 | 0 | 1 | 0 | 1
@junit | room-invitation-cancel | 3 | 0 | 0 | 1 | 4
