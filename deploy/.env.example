# Hosts
BACKEND_HOST=kurl.me
FRONTEND_HOST=app.kurl.me
TZ=Asia/Seoul

# MySQL
MYSQL_DATABASE=short_link
MYSQL_USER=short_link
MYSQL_PASSWORD=replace-me-strong
MYSQL_ROOT_PASSWORD=replace-me-strong-root

# Redis
REDIS_PASSWORD=replace-me-strong

# JWT keypair — generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Copy the body (between BEGIN/END lines) onto a single line for each var.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Google OAuth — Cloud Console → OAuth client ID (Web app)
# Authorized redirect URI: https://kurl.me/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 2FA secret encryption — 32 bytes base64. Generate with:
#   openssl rand -base64 32
TWOFA_AES_KEY=

# Optional — if you have a MaxMind license, fresh GeoLite2-City + ASN dbs are
# downloaded at build time. Without it the bundled fallback (city only) is used.
MAXMIND_LICENSE_KEY=

# PoW
POW_ENFORCE=true
POW_DIFFICULTY=3

# Per-user shortener quota
LINK_QUOTA_AUTHENTICATED=200

# Avatar upload (S3 presigned PUT). Bucket / IAM / CORS 셋업은 README 참조.
# 비워두면 avatar endpoint 가 503 — 앱 나머지는 정상.
AVATAR_S3_BUCKET=
AVATAR_S3_REGION=ap-northeast-2
# CDN 안 끼우면 비워둠 (자동으로 raw S3 virtual-host URL 사용).
AVATAR_S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Resized copies (<name>.w480.<ext>, <name>.w1080.<ext>) of note and post photos, written one at a
# time on a background thread after upload. The backfill walks every existing photo at one per
# interval; turn it on once after deploy and off when the log says it finished.
IMAGE_VARIANTS_ENABLED=true
IMAGE_VARIANTS_BACKFILL_ENABLED=false
IMAGE_VARIANTS_BACKFILL_INTERVAL=PT1S

# Federation relay (tag relays such as relay.fedi.buzz) — off unless true. Admins subscribe
# relays and switch OFF/COUNT/STORE through /api/v1/admin/federation/relays. MODE (OFF, COUNT or
# STORE) is taken at start only until an admin, or the relay stopping itself, has chosen one.
# SUBSCRIPTIONS is a comma list of relay actor URIs subscribed at start when not subscribed yet;
# removing one here does not unsubscribe it. PER_DAY bounds both what is queued and what is stored.
FEDERATION_RELAY_ENABLED=false
FEDERATION_RELAY_PER_MINUTE=30
FEDERATION_RELAY_PER_DAY=2000
FEDERATION_RELAY_QUEUE=500
FEDERATION_RELAY_MODE=
FEDERATION_RELAY_SUBSCRIPTIONS=
# Notes a relay brought or a pull kept that no member touched are deleted after this long.
FEDERATION_RELAY_KEEP_FOR=7d

# Federation profile directories (other instances' public directories, read twice a day) —
# off unless true. Admins add instances through /api/v1/admin/federation/directories.
FEDERATION_DIRECTORY_ENABLED=false
FEDERATION_DIRECTORY_NEW_PER_RUN=100
FEDERATION_DIRECTORY_CONSENT=P3D

# Posts trending on other servers, read every 30 minutes from each host's
# /api/v1/trends/statuses (comma-separated hosts) and kept in memory only — off unless true.
FEDERATION_TRENDS_ENABLED=false
FEDERATION_TRENDS_HOSTS=mastodon.social,mstdn.jp,fedibird.com,qdon.space,planet.moe,social.silicon.moe
FEDERATION_TRENDS_PER_HOST=40
FEDERATION_TRENDS_PAGES=2

# The newest public posts of these servers, asked only while someone reads 다른 서버 최신 and kept in
# memory (since_id, at most max-items, asked again after fresh-for). A server that shows visitors
# nothing rests for 1-24 hours.
FEDERATION_LATEST_ENABLED=true
FEDERATION_LATEST_HOSTS=mstdn.jp,qdon.space,planet.moe,social.silicon.moe
FEDERATION_LATEST_PER_HOST=40
FEDERATION_LATEST_MAX_ITEMS=600
FEDERATION_LATEST_FRESH_FOR=5m
FEDERATION_LATEST_PATIENCE=3s
# With PULL true the same servers are pulled every EVERY whether or not anyone reads, the posts are
# kept as notes (at most PER_DAY a day, the first pull reaching back at most BACKFILL_PAGES pages)
# and 다른 서버 최신 is read from them instead of memory.
FEDERATION_LATEST_PULL=false
FEDERATION_LATEST_EVERY=5m
FEDERATION_LATEST_BACKFILL_PAGES=5
FEDERATION_LATEST_PER_DAY=2000
